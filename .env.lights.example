# スマート電球の中継スクリプト（pnpm lights）の設定。このファイルを .env.lights へコピーして値を入れる。

# 展示のURL。末尾スラッシュなし。開発サーバーなら http://localhost:5173
LIGHT_ORIGIN=https://dpc-school-festival.<subdomain>.workers.dev

# Cloudflare Access のサービストークン（仕様書14章）。開発サーバーでは空のままでよい。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# matter.js の保存先。省略するとリポジトリ直下の .matter-lights/
# MATTER_STORAGE_PATH=
