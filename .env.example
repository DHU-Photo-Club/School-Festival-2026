# 会場サーバーの環境変数（docs/README.md 14章）。このファイルを .env へコピーして値を書く。
# .env は `pnpm start` と `pnpm dev` が読む。Gitには入れない。

# Mistral AI のAPIキー。なければAIの選定ができず、結果を出せない。
MISTRAL_API_KEY=
# 任意。モデルID（既定は mistral-small-latest）と、ベースURLの上書き。
# MISTRAL_MODEL=
# MISTRAL_BASE_URL=

# 結果ページのWorkerへ結果を送るトークン。`wrangler secret put RESULTS_UPLOAD_TOKEN` と同じ値にする。
# なければ結果を送らない。`pnpm dev` は設定してあっても送らない。
RESULTS_UPLOAD_TOKEN=

# 任意。待ち受けるポート（既定は 8787）とアドレス（既定は 0.0.0.0）。
# PORT=8787
# HOST=0.0.0.0
# 任意。展示状態と結果の記録を保存するSQLiteのファイル（既定は data/exhibit.sqlite）。
# DATA_FILE=
