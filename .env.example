# 色選定に使用するMistral AIのAPIキー
MISTRAL_API_KEY=

# 任意 - モデルID（既定は mistral-small-latest）と、ベースURLの上書き。
# MISTRAL_MODEL=
# MISTRAL_BASE_URL=

# 結果ページのWorkerへ結果を送るトークン。`wrangler secret put RESULTS_UPLOAD_TOKEN` と同じ値にする。
# なければ結果を送らない。`pnpm dev` は設定してあっても送らない。
RESULTS_UPLOAD_TOKEN=

# 任意。待ち受けるポート（既定は 8787）とアドレス（既定は 0.0.0.0）。
# PORT=8787
# HOST=0.0.0.0
# 任意。展示状態と結果の記録を保存するSQLiteのファイル（既定は data/exhibit.sqlite）。
# DATA_FILE=

# 任意。プロジェクターで投影する画面の台形補正（仕様書7.2.1節）。KEYSTONE_{ページのパス} に、
# 画面で K を押して調整したときに表示される一行を書き写す。空なら補正しない。
# KEYSTONE_DISPLAY_SPLIT_1=[[0.26525,-0.001],[-0.15598,-0.00044],[-0.10703,0.00875],[0.21555,-0.13035]]
# KEYSTONE_DISPLAY_SPLIT_2=

# 以下はスマート電球の中継スクリプト（pnpm lights、仕様書11章）の設定。会場サーバーは使わない。
# 任意。会場サーバーのURL（末尾スラッシュなし）。既定は同じPCの http://localhost:8787。開発サーバーなら http://localhost:5173
# LIGHT_ORIGIN=
# 任意。matter.js の保存先（電球の登録の記録）。既定はリポジトリ直下の .matter-lights/
# MATTER_STORAGE_PATH=
# 初期設定前の電球を Bluetooth で登録するときだけ書く（pnpm lights pair で使う）。電球はこのWi-Fiへつながる。
# 2.4GHz の Wi-Fi にする。IDとパスワードでログインする Wi-Fi（WPA2/WPA3-Enterprise）にはつなげない。
# LIGHT_WIFI_SSID=
# LIGHT_WIFI_PASSWORD=
