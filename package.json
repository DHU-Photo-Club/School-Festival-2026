{
  "name": "dpc-school-festival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "check": "wrangler types src/results/worker-configuration.d.ts && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.results.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types src/results/worker-configuration.d.ts",
    "build:results": "node scripts/build-results.ts",
    "deploy:results": "pnpm build && pnpm build:results && wrangler deploy",
    "export-photos": "node scripts/export-photos.ts",
    "export-sounds": "node scripts/export-sounds.ts",
    "lights": "node --env-file-if-exists=.env.lights scripts/light-bridge.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.76.0",
    "cn": "^0.5.2",
    "jsonc-parser": "^3.3.1",
    "qrcode-generator": "^2.0.4",
    "tailwind-variants": "^3.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@matter/main": "0.18.0",
    "@playwright/test": "^1.63.0",
    "@project-chip/matter.js": "0.18.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "shadcn-svelte": "^1.8.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
