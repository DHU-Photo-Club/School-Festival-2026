{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 結果ページのWorker（仕様書10章）。展示の本体は会場サーバーで動かし、このWorkerは来場者がQRコードで開く
	// 結果ページだけを配信する。会場サーバーも、このファイルの PUBLIC_ORIGIN と RESULTS_PUBLISHED_UNTIL を読む。
	"name": "dpc-school-festival",
	"main": "src/results/index.ts",
	"compatibility_date": "2026-10-01",
	// 結果の受け取り口（`PUT /api/results/{id}`）を持つため、入口を増やさないよう、バージョンごとのプレビューURLは使わない。
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		// `pnpm build:results` が dist/ から結果ページに要るファイルだけを集める（scripts/build-results.ts）。
		"directory": "./dist-results",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true
	},
	"kv_namespaces": [
		// 結果ページへ公開する部分を、結果IDをキーにして公開終了日時まで保存する。
		{ "binding": "RESULTS" }
	],
	"vars": {
		// 仮: 仕様書16章「Cloudflareアカウントのsubdomainと公開終了日時」の決定前の値。
		// 初回デプロイ後、確定したworkers.devのURLを末尾スラッシュなしで設定する（仕様書10.1節）。
		"PUBLIC_ORIGIN": "https://dpc-school-festival.tbd-subdomain.workers.dev",
		"RESULTS_PUBLISHED_UNTIL": "2026-12-31T15:00:00Z"
	}
}
