{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dpc-school-festival",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/result/*"]
	},
	"durable_objects": {
		"bindings": [{ "name": "EXHIBIT", "class_name": "Exhibit" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Exhibit"] }],
	"vars": {
		// 仮: 仕様書16章「Cloudflareアカウントのsubdomainと公開終了日時」の決定前の値。
		// 初回デプロイ後、確定したworkers.devのURLを末尾スラッシュなしで設定する（仕様書10.1節）。
		"PUBLIC_ORIGIN": "https://dpc-school-festival.tbd-subdomain.workers.dev",
		"RESULTS_PUBLISHED_UNTIL": "2026-12-31T15:00:00Z"
	}
}
